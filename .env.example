# Copy to .env and fill in. NEVER commit .env.
# In the cloud environment keys are injected as network secrets instead.

# --- LLM (D-054). Defaults live in config/settings.yaml (llm section); these override them.
# Default provider: NVIDIA NIM free tier (OpenAI-compatible).
NVIDIA_API_KEY=
# LLM_PROVIDER=openai_compatible      # openai_compatible | anthropic | mock
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LLM_MODEL_LIGHT=nvidia/nemotron-3-ultra-550b-a55b
# Local Ollama instead:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=<ollama model>
# Other OpenAI-compatible providers:  LLM_API_KEY=...
# Optional Anthropic provider (paid):
# ANTHROPIC_API_KEY=

# --- TCMB EVDS (EVDS3)
EVDS_API_KEY=

# --- EPİAŞ Transparency Platform (optional live API; PTF otherwise from data/manual/ptf.csv)
EPIAS_USERNAME=
EPIAS_PASSWORD=

# --- Misc
PUSULA_LOG_LEVEL=INFO
