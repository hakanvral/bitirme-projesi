# Copy to .env and fill in. NEVER commit .env.
# In the cloud environment these keys are injected as network secrets instead.

# --- LLM (needed from Phase 4) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_LIGHT=claude-haiku-5-5
LLM_TEMPERATURE=0

# --- TCMB EVDS (EVDS3) ---
# Get it from https://evds3.tcmb.gov.tr -> sign in -> profile -> API key.
EVDS_API_KEY=

# --- EPİAŞ Transparency Platform (optional live API; PTF is read from manual CSV by default) ---
EPIAS_USERNAME=
EPIAS_PASSWORD=

# --- Misc ---
PUSULA_LOG_LEVEL=INFO
